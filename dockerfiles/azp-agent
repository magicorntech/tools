ARG TAG_NUMBER
FROM public.ecr.aws/magicorn/tools-deploy:$TAG_NUMBER

LABEL Maintainer="Umur Coskuncan <umur@magicorn.co>" \
      Description="Deployer image that includes awscli, kubectl, helm, jq and many other modules made for Azure DevOps Pipelines."

RUN apk add --update-cache \
    bash \
    icu-libs \
    gcompat \
    libstdc++ \
    wget \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Install glibc for Node.js compatibility (Azure Pipelines agents require glibc)
# The Node.js binaries from Azure Pipelines are compiled for glibc and need fcntl64 symbol
RUN GLIBC_VERSION="2.35-r1" && \
    wget -q -O /etc/apk/keys/sgerrand.rsa.pub https://alpine-pkgs.sgerrand.com/sgerrand.rsa.pub && \
    wget https://github.com/sgerrand/alpine-pkg-glibc/releases/download/${GLIBC_VERSION}/glibc-${GLIBC_VERSION}.apk && \
    apk add --force-overwrite glibc-${GLIBC_VERSION}.apk && \
    rm -f glibc-${GLIBC_VERSION}.apk /etc/apk/keys/sgerrand.rsa.pub

ENV TARGETARCH="linux-x64"

WORKDIR /azp/

COPY dockerfiles/src/start.sh ./
RUN chmod +x ./start.sh

RUN adduser -D agent
RUN chown agent ./

USER agent
# Another option is to run the agent as root.
# ENV AGENT_ALLOW_RUNASROOT="true"

ENTRYPOINT ./start.sh