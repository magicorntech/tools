# Azure Pipelines agent — deploy imajı üzerine agent katmanı.
# Node (externals/node24) deploy’daki glibc ortamında çalışır.
ARG TAG_NUMBER=0.1.4-amd64
FROM public.ecr.aws/magicorn/tools-deploy:${TAG_NUMBER}

LABEL Maintainer="Umur Coskuncan <umur@magicorn.co>" \
      Description="Deployer image that includes awscli, kubectl, helm, jq and many other modules made for Azure DevOps Pipelines."

RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu70 \
    && rm -rf /var/lib/apt/lists/*

# Agent ve Node tool installer glibc bekliyor; platform linux-x64.
ENV TARGETARCH=linux-x64

WORKDIR /azp/

COPY dockerfiles/src/start.sh ./
RUN chmod +x ./start.sh

RUN adduser --disabled-password --gecos "" agent
RUN chown -R agent:agent /azp

USER agent

ENTRYPOINT ["./start.sh"]
