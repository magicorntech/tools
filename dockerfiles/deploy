# Debian Bookworm (glibc) – Azure Pipelines Node.js (externals/node24) bu tabanda çalışır.
# Alpine (musl) "unsupported relocation type 37" ve sembol hataları verir.
# Base image ECR'da tutulur (buildspec pre_build'da sync edilir).
ARG BASE_IMAGE=661204815105.dkr.ecr.us-east-1.amazonaws.com/debian:bookworm
FROM ${BASE_IMAGE}

LABEL Maintainer="Umur Coskuncan <umur@magicorn.co>" \
    Description="Deployer image that includes awscli, kubectl, helm, jq and many other modules."

WORKDIR /root

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gnupg \
    jq \
    openssh-client \
    unzip \
    zip \
    awscli \
    && rm -rf /var/lib/apt/lists/*

# kubectl (binary; arch matches build platform)
RUN ARCH=$(dpkg --print-architecture) \
    && curl -sLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${ARCH}/kubectl" \
    && chmod +x kubectl \
    && mv kubectl /usr/local/bin/

# Helm (binary; arch matches build platform)
RUN ARCH=$(dpkg --print-architecture) \
    && HELM_VERSION=$(curl -s https://api.github.com/repos/helm/helm/releases/latest | jq -r .tag_name) \
    && curl -sLO "https://get.helm.sh/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" \
    && tar -xzf helm-${HELM_VERSION}-linux-${ARCH}.tar.gz \
    && mv linux-${ARCH}/helm /usr/local/bin/ \
    && rm -rf helm-${HELM_VERSION}-linux-${ARCH}.tar.gz linux-${ARCH}
